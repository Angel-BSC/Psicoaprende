# Copia a .env y elige una contraseña local aleatoria. Nunca uses EXPO_PUBLIC_ para secretos.
POSTGRES_PASSWORD=REEMPLAZAR
DATABASE_URL=postgresql://psicoaprende:REEMPLAZAR@127.0.0.1:54329/psicoaprende
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Opcional en móvil: http://IP-DE-TU-PC:3001. Si se omite, se usa el host de Expo en desarrollo.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
